# Common location for test related Kconfigs

if ZTEST

rsource "test/test_utils/Kconfig"

config PLATFORM_EC_TEST_CC_USBPD
	bool "Enable USBPD console channel"
	help
	  Enable USBPD console channel

# ZTEST is enabled with Renode, we want these configs
# for normal ZTEST built on native_posix
if EC_HOST_CMD && ARCH_POSIX
config EC_HOST_CMD_BACKEND_SIMULATOR
	default y

config EC_HOST_CMD_DEDICATED_THREAD
	default y

# Most standard host command transactions use smaller payloads
# (e.g. 256 bytes for LPC/eSPI, 544 bytes for SPI/UART).
config EC_HOST_CMD_HANDLER_RX_BUFFER_SIZE
	default 544

config EC_HOST_CMD_HANDLER_TX_BUFFER_SIZE
	default 544
endif # EC_HOST_CMD && ARCH_POSIX

endif # ZTEST

config HW_TEST
	bool "Include tests that will be run on hardware"
	help
	  Enables building full image with zmake that includes tests.
	  The tests can be run via console or are run automatically depending
	  on a test framework and other configs.

if HW_TEST

config HW_TEST_RW_ONLY
	bool "Include harwdware tests only in the RW copy"
	default y

config HW_TEST_ON
	bool
	default y if HW_TEST_RW_ONLY && CROS_EC_RW
	default y if !HW_TEST_RW_ONLY

if HW_TEST_ON

rsource "test/hwtest/Kconfig"

endif # HW_TEST_ON
endif # HW_TEST
