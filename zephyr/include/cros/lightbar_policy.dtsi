#define LB_SEG_UNPLUG_OFF(n) \
	pattern-##n { \
		transition = "LED_TRANSITION_STEP"; \
		led-id = "EC_LED_ID_LIGHTBAR_LED"; \
		cycle-count = <1>; \
		color-0  { led-color = <&lightbar_seg##n##_off>; period-ms = <3984>; }; \
	};

#define LB_BAT_FULL(before, after) \
	LB_SEG_UNPLUG_0(before, green, after) \
	LB_SEG_UNPLUG_1(before, green, after) \
	LB_SEG_UNPLUG_2(before, green, after) \
	LB_SEG_UNPLUG_3(before, green, after)

