#define LB_LOGO_STARTUP_AC \
	LB_LOGO_SEG1(white) \
	LB_LOGO_SEG2(white) \
	LB_LOGO_SEG3(white) \
	LB_LOGO_SEG4(white) \

#define LB_LOGO_STARTUP_BATTERY \
