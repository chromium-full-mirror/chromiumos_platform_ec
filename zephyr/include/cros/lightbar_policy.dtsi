		led-id = "EC_LED_ID_LIGHTBAR_LED"; \
		cycle-count = <1>; \
		color-0  { led-color = <&lightbar_seg##n##_off>; period-ms = <8200>; }; \
	};

#define LB_CHARGE_ERROR \
	pattern-0 { \
		led-id = "EC_LED_ID_LIGHTBAR_LED"; \
		transition = "LED_TRANSITION_LINEAR"; \
		cycle-count = <8>; \
		color-0 { \
			led-color = <&lightbar_red>; \
			period-ms = <200>; \
		}; \
		color-1 { \
			led-color = <&lightbar_red>; \
			period-ms = <600>; \
		}; \
		color-2 { \
			led-color = <&lightbar_off>; \
			period-ms = <200>; \
		}; \
		color-3 { \
			led-color = <&lightbar_off>; \
			period-ms = <1000>; \
		}; \
	};

/ {
	lb-led-colors {
		compatible = "cros-ec,led-policy";
		led-pins = <&led_pins2>;

		/* Startup when the battery is completely drained */
		lb_state_startup_critical: lb-state-startup-critical {
			board-led-alt-policy-label = <LED_ALT_POLICY_STARTUP_CRITICAL>;
			LB_PATTERNS_CRITICAL
		};

		/* Shutdown animation - Cycle once then hold off */
		lb_state_shutdown: lb-state-shutdown {
			board-led-alt-policy-label = <LED_ALT_POLICY_SHUTDOWN>;
			batt-lvl = <1 100>;
			LB_LOGO_SHUTDOWN
		};

		lb_state_shutdown_critical: lb-state-shutdown-critical {
			board-led-alt-policy-label = <LED_ALT_POLICY_SHUTDOWN>;
			batt-lvl = <0 0>;
			pattern-0 {
				transition = "LED_TRANSITION_STEP";
				led-id = "EC_LED_ID_LIGHTBAR_LED";
				cycle-count = <1>;
				color-0 {
					led-color = <&lightbar_off>;
				};
			};
		};

		/* Suspend - same as shutdown */
		lb_state_suspend: lb-state-suspend {
			board-led-alt-policy-label = <LED_ALT_POLICY_SUSPEND>;
			LB_LOGO_SHUTDOWN
		};

		/* Startup and Resume from sleep */
		lb_state_logo_ac: lb-state-logo-ac {
			board-led-alt-policy-label = <LED_ALT_POLICY_LOGO_AC>;
			LB_LOGO_STARTUP_AC
		};

		lb_state_logo_battery: lb-state-logo-battery {
			board-led-alt-policy-label = <LED_ALT_POLICY_LOGO_BATTERY>;
			LB_LOGO_STARTUP_BATTERY
		};

		/* Default S0, various AC sub-states - 100% white */
		lb_state_default_s0_charge: lb-state-default-s0-charge {
			board-led-alt-policy-label = <LED_ALT_POLICY_NORMAL>;
			chipset-state = "POWER_S0";
			charge-state = "LED_PWRS_CHARGE",
				       "LED_PWRS_CHARGE_NEAR_FULL",
				       "LED_PWRS_IDLE",
				       "LED_PWRS_FORCED_IDLE";
			pattern-0 {
				transition = "LED_TRANSITION_STEP";
				led-id = "EC_LED_ID_LIGHTBAR_LED";
				cycle-count = <1>;
				color-0 {
					led-color = <&lightbar_white>;
				};
			};
		};

		/* Default S0, various battery sub-states, battery not low - Dim white */
		lb_state_default_s0_discharge_not_low: lb-state-default-s0-discharge-not-low {
			board-led-alt-policy-label = <LED_ALT_POLICY_NORMAL>;
			chipset-state = "POWER_S0";
			charge-state = "LED_PWRS_DISCHARGE";
			batt-lvl = <20 100>;
			pattern-0 {
				transition = "LED_TRANSITION_STEP";
				led-id = "EC_LED_ID_LIGHTBAR_LED";
				cycle-count = <1>;
				color-0 {
					led-color = <&lightbar_white_dim>;
				};
			};
		};

		/* Default S0, various battery sub-states, battery low - Off */
		lb_state_default_s0_discharge_low: lb-state-default-s0-discharge-low {
			board-led-alt-policy-label = <LED_ALT_POLICY_NORMAL>;
			chipset-state = "POWER_S0";
			charge-state = "LED_PWRS_DISCHARGE";
			batt-lvl = <0 19>;
			pattern-0 {
				transition = "LED_TRANSITION_STEP";
				led-id = "EC_LED_ID_LIGHTBAR_LED";
				cycle-count = <1>;
				color-0 {
					led-color = <&lightbar_off>;
				};
			};
		};

		lb_state_default_s0_charge_error: lb-state-default-s0-charge-error {
			board-led-alt-policy-label = <LED_ALT_POLICY_NORMAL>;
			chipset-state = "POWER_S0";
			charge-state = "LED_PWRS_ERROR";
			LB_CHARGE_ERROR
		};

		/* Default S3/S5 state - Off */
		lb-state-default-s3-s5 {
			board-led-alt-policy-label = <LED_ALT_POLICY_NORMAL>;
			chipset-state = "POWER_S3", "POWER_S5";
			pattern-0 {
				led-id = "EC_LED_ID_LIGHTBAR_LED";
				color-0 {
					led-color = <&lightbar_off>;
				};
			};
		};

		/* Idle glow disabled */
		lb-state-default-disabled {
			board-led-alt-policy-label = <LED_ALT_POLICY_IDLE_DISABLED>;
			pattern-0 {
				led-id = "EC_LED_ID_LIGHTBAR_LED";
				color-0 {
					led-color = <&lightbar_off>;
				};
			};
		};

		/* Dark resume debounce - Off */
		lb_state_resume_debounce: lb-state-resume-debounce {
			board-led-alt-policy-label = <LED_ALT_POLICY_RESUME_DEBOUNCE>;
			pattern-0 {
				led-id = "EC_LED_ID_LIGHTBAR_LED";
				color-0 {
					led-color = <&lightbar_off>;
					period-ms = <1500>;
				};
			};
		};

		lb_state_unplug_debounce_s0: lb-state-unplug-debounce-s0 {
			board-led-alt-policy-label = <LED_ALT_POLICY_UNPLUG_DEBOUNCE>;
			chipset-state = "POWER_S0";
			pattern-0 {
				led-id = "EC_LED_ID_LIGHTBAR_LED";
				color-0 {
					led-color = <&lightbar_white>;
					period-ms = <1100>;
				};
			};
		};

		lb_state_unplug_debounce_s3_s5: lb-state-unplug-debounce-s3-s5 {
			board-led-alt-policy-label = <LED_ALT_POLICY_UNPLUG_DEBOUNCE>;
			chipset-state = "POWER_S3", "POWER_S5";
			pattern-0 {
				led-id = "EC_LED_ID_LIGHTBAR_LED";
				color-0 {
					led-color = <&lightbar_off>;
					period-ms = <1100>;
				};
			};
		};

		/* Unplugging - Battery low (below 20%) */
		lb_state_unplug_low_s0: lb-state-unplug-low-s0 {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_UNPLUG_S0>;
			batt-lvl = <0 19>;
			LB_SEG_UNPLUG_0(white, red, white_dim)
			LB_SEG_UNPLUG_1(white, white_dim, white_dim)
			LB_SEG_UNPLUG_2(white, white_dim, white_dim)
			LB_SEG_UNPLUG_3(white, white_dim, white_dim)
		};

		lb_state_unplug_low: lb-state-unplug-low {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_UNPLUG_S3S5>;
			batt-lvl = <0 19>;
			LB_SEG_UNPLUG_0(off, red, off)
			LB_SEG_UNPLUG_OFF(1)
			LB_SEG_UNPLUG_OFF(2)
			LB_SEG_UNPLUG_OFF(3)
		};

		/* Unplugging - Battery medium (between 20% and 59%) */
		lb_state_unplug_med_s0: lb-state-unplug-med-s0 {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_UNPLUG_S0>;
			batt-lvl = <20 59>;
			LB_SEG_UNPLUG_0(white, yellow, white_dim)
			LB_SEG_UNPLUG_1(white, yellow, white_dim)
			LB_SEG_UNPLUG_2(white, white_dim, white_dim)
			LB_SEG_UNPLUG_3(white, white_dim, white_dim)
		};

		lb_state_unplug_med: lb-state-unplug-med {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_UNPLUG_S3S5>;
			batt-lvl = <20 59>;
			LB_SEG_UNPLUG_0(off, yellow, off)
			LB_SEG_UNPLUG_1(off, yellow, off)
			LB_SEG_UNPLUG_OFF(2)
			LB_SEG_UNPLUG_OFF(3)
		};

		/* Unplugging - Battery high (between 60% and 94%) */
		lb_state_unplug_high_s0: lb-state-unplug-high-s0 {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_UNPLUG_S0>;
			batt-lvl = <60 94>;
			LB_SEG_UNPLUG_0(white, green, white_dim)
			LB_SEG_UNPLUG_1(white, green, white_dim)
			LB_SEG_UNPLUG_2(white, green, white_dim)
			LB_SEG_UNPLUG_3(white, white_dim, white_dim)
		};

		lb_state_unplug_high: lb-state-unplug-high {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_UNPLUG_S3S5>;
			batt-lvl = <60 94>;
			LB_SEG_UNPLUG_0(off, green, off)
			LB_SEG_UNPLUG_1(off, green, off)
			LB_SEG_UNPLUG_2(off, green, off)
			LB_SEG_UNPLUG_OFF(3)
		};

		/* Unplugging - Battery full (over 94%) */
		lb_state_unplug_full_s0: lb-state-unplug-full-s0 {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_UNPLUG_S0>;
			batt-lvl = <95 100>;
			LB_BAT_FULL(white, white_dim)
		};

		lb_state_unplug_full: lb-state-unplug-full {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_UNPLUG_S3S5>;
			batt-lvl = <95 100>;
			LB_BAT_FULL(off, off)
		};

		/* Plugging - Battery low (below 20%) */
		lb_state_plug_low_s0: lb-state-plug-low-s0 {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_PLUG_S0>;
			charge-state = "LED_PWRS_CHARGE",
				       "LED_PWRS_DISCHARGE",
				       "LED_PWRS_IDLE",
				       "LED_PWRS_FORCED_IDLE",
				       "LED_PWRS_CHARGE_NEAR_FULL";
			batt-lvl = <0 19>;
			LB_SEG_PLUG_0(white_dim, red, red_65, white)
			LB_SEG_PLUG_1_OFF(white_dim, white_dim, white)
			LB_SEG_PLUG_2_OFF(white_dim, white_dim, white)
			LB_SEG_PLUG_3_OFF(white_dim, white_dim, white)
		};

		lb_state_plug_low: lb-state-plug-low {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_PLUG_S3S5>;
			charge-state = "LED_PWRS_CHARGE",
				       "LED_PWRS_DISCHARGE",
				       "LED_PWRS_IDLE",
				       "LED_PWRS_FORCED_IDLE",
				       "LED_PWRS_CHARGE_NEAR_FULL";
			batt-lvl = <0 19>;
			LB_SEG_PLUG_0(off, red, red_65, off)
			LB_SEG_PLUG_OFF(1)
			LB_SEG_PLUG_OFF(2)
			LB_SEG_PLUG_OFF(3)
		};

		/* Plugging - Battery medium (between 20% and 59%) */
		lb_state_plug_med_s0: lb-state-plug-med-s0 {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_PLUG_S0>;
			charge-state = "LED_PWRS_CHARGE",
				       "LED_PWRS_DISCHARGE",
				       "LED_PWRS_IDLE",
				       "LED_PWRS_FORCED_IDLE",
				       "LED_PWRS_CHARGE_NEAR_FULL";
			batt-lvl = <20 59>;
			LB_SEG_PLUG_0(white_dim, yellow, yellow_65, white)
			LB_SEG_PLUG_1(white_dim, yellow, yellow_65, white)
			LB_SEG_PLUG_2_OFF(white_dim, white_dim, white)
			LB_SEG_PLUG_3_OFF(white_dim, white_dim, white)
		};

		lb_state_plug_med: lb-state-plug-med {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_PLUG_S3S5>;
			charge-state = "LED_PWRS_CHARGE",
				       "LED_PWRS_DISCHARGE",
				       "LED_PWRS_IDLE",
				       "LED_PWRS_FORCED_IDLE",
				       "LED_PWRS_CHARGE_NEAR_FULL";
			batt-lvl = <20 59>;
			LB_SEG_PLUG_0(off, yellow, yellow_65, off)
			LB_SEG_PLUG_1(off, yellow, yellow_65, off)
			LB_SEG_PLUG_OFF(2)
			LB_SEG_PLUG_OFF(3)
		};

		/* Plugging - Battery high (between 60% and 94%) */
		lb_state_plug_high_s0: lb-state-plug-high-s0 {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_PLUG_S0>;
			charge-state = "LED_PWRS_CHARGE",
				       "LED_PWRS_DISCHARGE",
				       "LED_PWRS_IDLE",
				       "LED_PWRS_FORCED_IDLE",
				       "LED_PWRS_CHARGE_NEAR_FULL";
			batt-lvl = <60 94>;
			LB_SEG_PLUG_0(white_dim, green, green_65, white)
			LB_SEG_PLUG_1(white_dim, green, green_65, white)
			LB_SEG_PLUG_2(white_dim, green, green_65, white)
			LB_SEG_PLUG_3_OFF(white_dim, white_dim, white)
		};

		lb_state_plug_high: lb-state-plug-high {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_PLUG_S3S5>;
			charge-state = "LED_PWRS_CHARGE",
				       "LED_PWRS_DISCHARGE",
				       "LED_PWRS_IDLE",
				       "LED_PWRS_FORCED_IDLE",
				       "LED_PWRS_CHARGE_NEAR_FULL";
			batt-lvl = <60 94>;
			LB_SEG_PLUG_0(off, green, green_65, off)
			LB_SEG_PLUG_1(off, green, green_65, off)
			LB_SEG_PLUG_2(off, green, green_65, off)
			LB_SEG_PLUG_OFF(3)
		};

		/* Plugging - Battery full (over 94%) */
		lb_state_plug_full_s0: lb-state-plug-full-s0 {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_PLUG_S0>;
			charge-state = "LED_PWRS_CHARGE",
				       "LED_PWRS_DISCHARGE",
				       "LED_PWRS_IDLE",
				       "LED_PWRS_FORCED_IDLE",
				       "LED_PWRS_CHARGE_NEAR_FULL";
			batt-lvl = <95 100>;
			LB_BAT_FULL(white_dim, white)
		};

		lb_state_plug_full: lb-state-plug-full {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_PLUG_S3S5>;
			charge-state = "LED_PWRS_CHARGE",
				       "LED_PWRS_DISCHARGE",
				       "LED_PWRS_IDLE",
				       "LED_PWRS_FORCED_IDLE",
				       "LED_PWRS_CHARGE_NEAR_FULL";
			batt-lvl = <95 100>;
			LB_BAT_FULL(off, off)
		};

		/* Plugging - Charge error */
		lb_state_plug_error_s0: lb-state-plug-error-s0 {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_PLUG_S0>;
			charge-state = "LED_PWRS_ERROR";
			LB_CHARGE_ERROR
		};

		lb_state_plug_error: lb-state-plug-error {
			board-led-alt-policy-label = <LED_ALT_POLICY_AC_PLUG_S3S5>;
			charge-state = "LED_PWRS_ERROR";
			LB_CHARGE_ERROR
		};
	};
};
