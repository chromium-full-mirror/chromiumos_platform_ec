	LB_LOGO_SEG2(white_dim) \
	LB_LOGO_SEG3(white_dim) \
	LB_LOGO_SEG4(white_dim) \

#define LB_LOGO_OFF(n, base, dim) \
	pattern-##n { \
		transition = "LED_TRANSITION_LINEAR"; \
		led-id = "EC_LED_ID_LIGHTBAR_LED"; \
		cycle-count = <1>; \
		color-0  { led-color = <&lightbar_seg##n##_##dim>;  period-ms = <0>; }; \
		color-1  { led-color = <&lightbar_seg##n##_##base>; period-ms = <200>; }; \
		color-2  { led-color = <&lightbar_seg##n##_##base>; period-ms = <2600>; }; \
		color-3  { led-color = <&lightbar_seg##n##_off>;    period-ms = <500>; }; \
	};

#define LB_LOGO_SHUTDOWN \
	LB_LOGO_OFF(0, blue, blue_65) \
	LB_LOGO_OFF(1, green, green_65) \
	LB_LOGO_OFF(2, yellow, yellow_65) \
	LB_LOGO_OFF(3, red, red_65)

/* AC unplug macros */
#define LB_SEG_UNPLUG_0(before, base, after) \
	pattern-0 { \
		transition = "LED_TRANSITION_LINEAR"; \
		led-id = "EC_LED_ID_LIGHTBAR_LED"; \
		cycle-count = <1>; \
		color-0  { led-color = <&lightbar_seg0_##before>; period-ms = <0>; }; \
		color-1  { led-color = <&lightbar_seg0_##base>;   period-ms = <200>; }; \
		color-2  { led-color = <&lightbar_seg0_##base>;   period-ms = <3484>; }; \
		color-3  { led-color = <&lightbar_seg0_##after>;  period-ms = <300>; }; \
	};

