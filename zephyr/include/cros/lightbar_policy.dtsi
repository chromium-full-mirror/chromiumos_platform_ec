#include <cros/lightbar_colors.dtsi>
#include <drivers/lightbar_policy_alt.h>

/* Macros for the critical battery animation. */
#define LB_SEG_CRITICAL_0 \
	pattern-0 { \
		transition = "LED_TRANSITION_LINEAR"; \
		led-id = "EC_LED_ID_LIGHTBAR_LED"; \
		cycle-count = <1>; \
		color-0  { led-color = <&lightbar_seg0_off>;    period-ms = <0>; }; \
		color-1  { led-color = <&lightbar_seg0_off>;    period-ms = <133>; }; \
		color-2  { led-color = <&lightbar_seg0_red>;    period-ms = <333>; }; \
		color-3  { led-color = <&lightbar_seg0_red>;    period-ms = <300>; }; \
		color-4  { led-color = <&lightbar_seg0_red_65>; period-ms = <433>; }; \
		color-5  { led-color = <&lightbar_seg0_red_65>; period-ms = <700>; }; \
		color-6  { led-color = <&lightbar_seg0_red>;    period-ms = <200>; }; \
		color-7  { led-color = <&lightbar_seg0_red>;    period-ms = <13152>; }; \
		color-8  { led-color = <&lightbar_seg0_off>;    period-ms = <333>; }; \
	};

#define LB_SEG_CRITICAL_1 \
	pattern-1 { \
		transition = "LED_TRANSITION_LINEAR"; \
		led-id = "EC_LED_ID_LIGHTBAR_LED"; \
		cycle-count = <1>; \
		color-0  { led-color = <&lightbar_seg1_off>;    period-ms = <0>; }; \
		color-1  { led-color = <&lightbar_seg1_red>;    period-ms = <333>; }; \
		color-2  { led-color = <&lightbar_seg1_red>;    period-ms = <267>; }; \
		color-3  { led-color = <&lightbar_seg1_red_65>; period-ms = <467>; }; \
		color-4  { led-color = <&lightbar_seg1_red_65>; period-ms = <833>; }; \
		color-5  { led-color = <&lightbar_seg1_off>;    period-ms = <267>; }; \
		color-6  { led-color = <&lightbar_seg1_off>;    period-ms = <13417>; }; \
	};

#define LB_SEG_CRITICAL_2 \
	pattern-2 { \
		transition = "LED_TRANSITION_LINEAR"; \
		led-id = "EC_LED_ID_LIGHTBAR_LED"; \
