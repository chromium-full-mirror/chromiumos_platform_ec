		color-3  { led-color = <&lightbar_seg2_red_65>; period-ms = <467>; }; \
		color-4  { led-color = <&lightbar_seg2_red_65>; period-ms = <833>; }; \
		color-5  { led-color = <&lightbar_seg2_off>;    period-ms = <333>; }; \
		color-6  { led-color = <&lightbar_seg2_off>;    period-ms = <13351>; }; \
