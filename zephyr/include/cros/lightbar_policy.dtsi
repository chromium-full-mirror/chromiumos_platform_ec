	LB_SEG_CRITICAL_0 \
	LB_SEG_CRITICAL_1 \
	LB_SEG_CRITICAL_2 \
	LB_SEG_CRITICAL_3

/* Logo macros */
#define LB_LOGO_SEG1(after) \
	pattern-0 { \
		transition = "LED_TRANSITION_LINEAR"; \
		led-id = "EC_LED_ID_LIGHTBAR_LED"; \
		cycle-count = <1>; \
		color-0  { led-color = <&lightbar_seg0_off>;       period-ms = <0>; }; \
		color-1  { led-color = <&lightbar_seg0_white_dim>; period-ms = <650>; }; \
		color-2  { led-color = <&lightbar_seg0_white_dim>; period-ms = <517>; }; \
		color-3  { led-color = <&lightbar_seg0_blue>;      period-ms = <317>; }; \
		color-4  { led-color = <&lightbar_seg0_red>;       period-ms = <283>; }; \
		color-5  { led-color = <&lightbar_seg0_yellow>;    period-ms = <350>; }; \
		color-6  { led-color = <&lightbar_seg0_green>;     period-ms = <333>; }; \
		color-7  { led-color = <&lightbar_seg0_blue>;      period-ms = <350>; }; \
		color-8  { led-color = <&lightbar_seg0_red>;       period-ms = <350>; }; \
		color-9  { led-color = <&lightbar_seg0_yellow>;    period-ms = <333>; }; \
		color-10  { led-color = <&lightbar_seg0_green>;    period-ms = <350>; }; \
		color-11  { led-color = <&lightbar_seg0_blue>;     period-ms = <333>; }; \
		color-12  { led-color = <&lightbar_seg0_red>;      period-ms = <350>; }; \
		color-13  { led-color = <&lightbar_seg0_##after>;  period-ms = <317>; }; \
		color-14  { led-color = <&lightbar_seg0_##after>;  period-ms = <483>; }; \
	};

