# ARM specific Kconfig overrides.

configdefault TRAP_UNALIGNED_ACCESS
	default y

choice NULL_POINTER_EXCEPTION_DETECTION
	default NULL_POINTER_EXCEPTION_DETECTION_MPU
endchoice

configdefault CORTEX_M_NULL_POINTER_EXCEPTION_PAGE_SIZE
	# Using 0x20 because NPCX accesses 0x40 for down_from_flash_api.
	# See b/282983670 for other NPCX ROM accesses.
	default "0x20"

# Stackwalk on ARM causes build problems on many platforms, disable for now.
configdefault ARCH_HAS_STACKWALK
	default n

# Reset core registers, MPU, and NVIC state on entry for RO <-> RW sysjumps.
configdefault INIT_ARCH_HW_AT_BOOT
	default y

# Required for NPCX SHI host command driver to transition from suspended
# state to active state via pm_device_runtime_get() on AP startup.
configdefault PM_DEVICE_RUNTIME
	default y if EC_HOST_CMD_BACKEND_SHI_NPCX
