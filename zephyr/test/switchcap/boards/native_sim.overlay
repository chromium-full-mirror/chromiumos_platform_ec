#include <board-overlays/native_sim.dts>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	switchcap: switchcap {
		compatible = "cros-ec,switchcap";
		enable-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
		power-good-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
		power-off-delay-ms = <10>;
	};
};
