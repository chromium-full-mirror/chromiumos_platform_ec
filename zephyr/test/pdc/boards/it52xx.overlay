#include "native_sim.overlay"

&i2c0 {
	pdc_emul1: it52xx-pdc@26 {
		compatible = "ite,it52xx-pdc";
		reg = <0x26>;
		ccd;
	};

	pdc_emul2: it52xx-pdc@27 {
		compatible = "ite,it52xx-pdc";
		reg = <0x27>;
	};
};
