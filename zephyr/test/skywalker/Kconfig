choice
    prompt "Select the test suite"

config TEST_SKYWALKER
    bool "Run the tests intended for Skywalker"
    help
      Enable the Skywalker test suite.

config TEST_ANAKIN
    bool "Run the tests intended for Anakin"
    help
      Enable the Anakin test suite.

endchoice

