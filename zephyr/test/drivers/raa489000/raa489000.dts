#include <dt-bindings/usb_pd_tcpm.h>

/ {
	usbc {
		port0@0 {
			compatible = "named-usbc-port";
			tcpc = <&raa489000_emul>;
		};

		port1@1 {
			compatible = "named-usbc-port";
			chg = <&isl923x_sec_emul>;
		};
	};
};

&i2c2 {
	status="okay";

	raa489000_emul: raa489000@22 {
		compatible = "renesas,raa489000";
		status = "okay";
		reg = <0x22>;
		tcpc-flags = <(
			TCPC_FLAGS_TCPCI_REV2_0 |
			TCPC_FLAGS_VBUS_MONITOR)>;
	};

	isl923x_sec_emul: isl923x-sec@9 {
		compatible = "cros,isl923x-emul";
		status = "okay";
		reg = <0x9>;
		battery = <&battery>;
	};
};
