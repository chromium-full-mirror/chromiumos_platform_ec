#include <board-overlays/native_sim.dts>
#include <cros/binman.dtsi>

/ {
	chosen {
		cros-ec,flash-controller = &cros_flash;
	};

	aliases {
		gpio-wp = &gpio_wp_l;
	};

	named-gpios {
		gpio_wp_l: wp_l {
			gpios = <&gpio0 0 (GPIO_INPUT | GPIO_ACTIVE_LOW)>;
		};
	};

	cros_flash: cros-flash {
		compatible = "cros-ec,flash-emul";
	};
};

/* Configure existing simulated flash from native_sim.dts */
&flash0 {
	erase-block-size = <0x1000>;
	write-block-size = <256>;
	reg = <0x00000000 DT_SIZE_K(2048)>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* 4 erase sectors: small enough to exercise every one. */
		fingerprint_sensor_vendor_data: partition@100000 {
			label = "fingerprint_sensor_vendor_data";
			reg = <0x100000 DT_SIZE_K(16)>;
		};
	};
};
