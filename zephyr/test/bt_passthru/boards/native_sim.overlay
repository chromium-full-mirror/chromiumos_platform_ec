#include <board-overlays/native_sim.dts>

&bt_hci_userchan {
	status = "disabled";
};

/ {
	chosen {
		zephyr,bt-hci = &mock_bt_hci;
	};

	mock_bt_hci: mock_bt_hci {
		compatible = "zephyr,bt-hci-mock";
		status = "okay";
	};
};
