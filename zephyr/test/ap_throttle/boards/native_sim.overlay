#include <board-overlays/native_sim.dts>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	ap_throttle: ap-throttle {
		compatible = "cros-ec,ap-throttle";
		throttle-gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
		ac-only-boot-throttle;
	};
};
