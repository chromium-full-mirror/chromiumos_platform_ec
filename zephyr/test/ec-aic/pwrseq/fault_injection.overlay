/ {
	common-pwrseq {
		/* Violate tPCH03 (< 10 ms): deassert RSMRST# after only 1 ms */
		rsmrst-delay = <1>;
		/* Violate tPLT04 (< 1 ms), tPCH08 (< 1 ms), and tPLT05 (< 10 ms) */
		sys-pwrok-delay = <0>;
		pch-pwrok-delay = <0>;
	};
};
