config TEST_SYSTEM_MPU
	bool "Enable MPU for system_common tests"
	default y
	select CPU_HAS_MPU
	select MPU

config TEST_CORTEX_M_MPU
	bool "Test Cortex-M MPU shim on native_sim"
	select ARM_MPU
	select NPCX_RAM_LOCK

source "Kconfig.zephyr"
