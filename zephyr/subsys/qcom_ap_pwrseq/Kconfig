config QCOM_AP_PWRSEQ_DRIVER
	bool "Qualcomm AP power sequencing driver"
	default y
	depends on DT_HAS_CROS_EC_QCOM_AP_PWRSEQ_ENABLED
	select AP_POWER_CONTROL if PLATFORM_EC
	help
	  Enables the AP power sequence driver for Qualcomm chipsets.

if QCOM_AP_PWRSEQ_DRIVER

config QCOM_AP_PWRSEQ_STACK_SIZE
	int "Qualcomm AP power sequencing thread stack size (in bytes)"
	default 1536
	help
	  Set stack size of the Qualcomm AP power sequencer thread.

config QCOM_AP_PWRSEQ_THREAD_PRIORITY
	int "Qualcomm AP power sequencing thread priority"
	default 5
	help
	  Set thread priority of the Qualcomm AP power sequencer.

endif # QCOM_AP_PWRSEQ_DRIVER
