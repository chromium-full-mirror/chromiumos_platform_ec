/* blanc-ish project DTSI includes */
#include <dt-bindings/gpio_defines.h>
#include "i2c.dtsi"

/ {
	chosen {
		zephyr,sram = &sram;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &sram;
	};

	named-gpios {
		compatible = "named-gpios";

		ec_entering_rw {
			enum-name = "GPIO_ENTERING_RW";
		};
	};
};
