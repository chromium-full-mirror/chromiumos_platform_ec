#include <zephyr/dt-bindings/sensor/pac194x.h>

/ {
	pwrmon: pwrmon {
		compatible = "cros,pwrmon";
		power-monitors = <&pac1>, <&pac2>, <&pac3>, <&pac4>,
				 <&pac5>, <&pac6>, <&pac7>, <&pac8>;
		sample-rate = <1024>;
		gpios = <&gpiof 6 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
		zephyr,deferred-init;
	};
};

&i2c2 {
	pac1: pac1954@10 {
		compatible = "microchip,pac194x";
		reg = <0x10>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		microchip,refresh-mode = <PAC_REFRESH_MANUAL>;
		zephyr,deferred-init;

		/* VREG_L5B_0P752 (RS4506: 10 mOhm) */
		channel@1 {
			reg = <0x1>;
			friendly-name = "VREG_L5B_0P752";
			microchip,shunt-resistor-micro-ohms = <10000>;
			microchip,vbus-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,vsense-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,accumulation-mode = <PAC_ACCUM_VPOWER>;
		};
		/* PPVAR_SYS (R3131: 10 mOhm) */
		channel@2 {
			reg = <0x2>;
			friendly-name = "PPVAR_SYS";
			microchip,shunt-resistor-micro-ohms = <10000>;
			microchip,vbus-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,vsense-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,accumulation-mode = <PAC_ACCUM_VPOWER>;
		};
		/* PPVAR_BATT_DISCHG (R3508: 10 mOhm) */
		channel@3 {
			reg = <0x3>;
			friendly-name = "PPVAR_BATT_DISCHG";
			microchip,shunt-resistor-micro-ohms = <10000>;
			microchip,vbus-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,vsense-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,accumulation-mode = <PAC_ACCUM_VPOWER>;
		};
		/* PP3300_WLAN (R5547: 20 mOhm) */
		channel@4 {
			reg = <0x4>;
			friendly-name = "PP3300_WLAN";
			microchip,shunt-resistor-micro-ohms = <20000>;
			microchip,vbus-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,vsense-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,accumulation-mode = <PAC_ACCUM_VPOWER>;
		};
	};

	pac2: pac1954@11 {
		compatible = "microchip,pac194x";
		reg = <0x11>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		microchip,refresh-mode = <PAC_REFRESH_MANUAL>;
		zephyr,deferred-init;

		/* PP5000_Z1 (R3310: 10 mOhm, R3311: ns) */
		channel@1 {
			reg = <0x1>;
			friendly-name = "PP5000_Z1";
			microchip,shunt-resistor-micro-ohms = <10000>;
			microchip,vbus-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,vsense-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,accumulation-mode = <PAC_ACCUM_VPOWER>;
		};
		/* PP5000_SPKR_L (RS8601: 20 mOhm) */
		channel@2 {
			reg = <0x2>;
			friendly-name = "PP5000_SPKR_L";
			microchip,shunt-resistor-micro-ohms = <20000>;
			microchip,vbus-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,vsense-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,accumulation-mode = <PAC_ACCUM_VPOWER>;
		};
		/* PP3300_PDC (RS6201: 20 mOhm) */
		channel@3 {
			reg = <0x3>;
			friendly-name = "PP3300_PDC";
			microchip,shunt-resistor-micro-ohms = <20000>;
			microchip,vbus-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,vsense-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,accumulation-mode = <PAC_ACCUM_VPOWER>;
		};
		/* PP5000_HUB (RS9701: 20 mOhm) */
		channel@4 {
			reg = <0x4>;
			friendly-name = "PP5000_HUB";
			microchip,shunt-resistor-micro-ohms = <20000>;
			microchip,vbus-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,vsense-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,accumulation-mode = <PAC_ACCUM_VPOWER>;
		};
	};

	pac3: pac1954@12 {
		compatible = "microchip,pac194x";
		reg = <0x12>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		microchip,refresh-mode = <PAC_REFRESH_MANUAL>;
