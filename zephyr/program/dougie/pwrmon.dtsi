			microchip,vsense-mode = <PAC_BIPOLAR_HALF_FSR>;
			microchip,accumulation-mode = <PAC_ACCUM_VPOWER>;
		};
		/* VPH_PWR (R5119: 2 mOhm, R5118: ns) */
		channel@3 {
			reg = <0x3>;
			friendly-name = "VPH_PWR";
			microchip,shunt-resistor-micro-ohms = <2000>;
