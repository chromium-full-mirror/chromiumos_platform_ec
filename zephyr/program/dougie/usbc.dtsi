#include <usbc-policy.dtsi>

/ {
	usbc {
		#address-cells = <1>;
		#size-cells = <0>;

		usbc_port0: port0@0 {
			compatible = "named-usbc-port";
			reg = <0>;
			chg = <&charger_bq25720>;
			pdc = <&pdc_power_p0>;
			policy = <&cros_policy>;
		};

		usbc_port1: port1@1 {
			compatible = "named-usbc-port";
			reg = <1>;
			pdc = <&pdc_power_p1>;
			policy = <&cros_policy>;
		};

		dp_alt_mode: dp-alt-mode {
			compatible = "cros-ec,pdc-dp-alt-mode";
			hpd-gpios = <&gpiof 3 (GPIO_ACTIVE_HIGH | GPIO_VOLTAGE_1P8)>;
			aux-path-sel-gpios = <&gpioj 7 GPIO_ACTIVE_HIGH>;
		};

		ppm-driver {
			compatible = "ucsi-ppm";
		};
	};
};

&i2c0 {
	charger_bq25720: bq25720@9 {
		compatible = "ti,bq25710";
		status = "okay";
		reg = <0x9>;
	};
};

&i2c4 {
	pdc_power_p0: tps6699-pdc@24 {
		compatible = "ti,tps6699-pdc";
		reg = <0x24>;
		irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
		port-index-on-chip = <2>;
		frs-supported;
		ccd;
	};
	pdc_power_p1: tps6699-pdc@20 {
		compatible = "ti,tps6699-pdc";
		reg = <0x20>;
		irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
		port-index-on-chip = <1>;
		frs-supported;
		no-fw-update;
	};
};
