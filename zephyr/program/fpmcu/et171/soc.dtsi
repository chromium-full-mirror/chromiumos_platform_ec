#include <cros/egis/et171.dtsi>

/delete-node/ &sram;

/ {
	chosen {
		cros-ec,bbram = &bbram;
	};

	sdcp: memory@0 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0x00000000 256>;
	};

	memory@100 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x100 32>;
		zephyr,memory-region = "RetainedMem";
		status = "okay";

		bbram: retained-ram {
			compatible = "zephyr,retained-ram";
			status = "okay";
			#address-cells = <1>;
			#size-cells = <1>;
		};
	};

	sram: memory@400 {
		device_type = "memory";
		compatible = "mmio-sram";
		/* Round down to kB, because the SRAM_SIZE config uses kB as SRAM
		 * size
		 */
		reg = <0x00000400 DT_SIZE_K(383)>;
	};

	sdcp_h_f: memory@90000000 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0x90000000 32>;
	};

	sdcp_s_d: memory@90000020 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0x90000020 64>;
	};

	sdcp_pk_f: memory@90000060 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0x90000060 65>;
	};

	sdcp_sk_f: memory@900000a1 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0x900000a1 32>;
	};
};

&spi0 {
	status = "okay";
	clock-frequency = <200000000>;
};

&spi1 {
	status = "okay";
	/delete-property/ clock-frequency;
	clocks = <&clock ET171_CLOCK_SPIM2>;
};

&syscon {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	/delete-property/ clock-frequency;
};

&clock {
	/*
	 * CPU is clocked from AHB. The base clock is 200Mhz.
	 * AHB clock = Base clock / AHB divider
	 */
	ahb-divide = <1>;
	/*
	 * APB Source Clock is AHB Clock divided by 2.
	 * APB clock = AHB clock / 2 / APB divider
	 */
	apb-divide = <2>;
};
