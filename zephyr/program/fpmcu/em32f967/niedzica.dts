#include "common.dtsi"

#define ELANI80SA_COMMON_IMAGE_PROPS \
	width = <80>; \
	height = <80>; \
	bits-per-pixel = <8>; \
	frame-size = <12800>; \
	image-data-offset-bytes = <6400>; \
	v4l2-pixel-format = "V4L2_PIX_FMT_GREY";


&spi2 {
	fp_sensor: elani80sa@0 {
		compatible = "elan,elani80sa";
		reg = <0>;
		spi-max-frequency = <8000000>;

		configs {
			compatible = "fingerprint-image-frame-params";
			config0 {
				ELANI80SA_COMMON_IMAGE_PROPS
				capture-type = "FINGERPRINT_CAPTURE_TYPE_VENDOR_FORMAT";
			};
			config1 {
				ELANI80SA_COMMON_IMAGE_PROPS
				capture-type = "FINGERPRINT_CAPTURE_TYPE_SIMPLE_IMAGE";
			};
			config2 {
				ELANI80SA_COMMON_IMAGE_PROPS
				capture-type = "FINGERPRINT_CAPTURE_TYPE_PATTERN0";
			};
			config3 {
				ELANI80SA_COMMON_IMAGE_PROPS
				capture-type = "FINGERPRINT_CAPTURE_TYPE_PATTERN1";
			};
			config4 {
				ELANI80SA_COMMON_IMAGE_PROPS
				capture-type = "FINGERPRINT_CAPTURE_TYPE_QUALITY_TEST";
			};
			config5 {
				ELANI80SA_COMMON_IMAGE_PROPS
				capture-type = "FINGERPRINT_CAPTURE_TYPE_RESET_TEST";
			};
		};

		irq-gpios = <&gpioa 15 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpioa 14 GPIO_ACTIVE_LOW>;
		base-image = <&base_image>;
		ft-info = <&ft_info>;
	};
};
