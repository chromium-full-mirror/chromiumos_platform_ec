#include <usbc-policy.dtsi>

 /{
	usbc {
		#address-cells = <1>;
		#size-cells = <0>;
		usbc_port0: port0@0 {
			compatible = "named-usbc-port";
			reg = <0>;
			chg = <&charger>;
			pdc = <&pdc_power_p0>;
			pd-retimer;
			policy = <&cros_policy>;
		};
		usbc_port1: port1@1 {
			compatible = "named-usbc-port";
			reg = <1>;
			pdc = <&pdc_power_p1>;
			pd-retimer;
			policy = <&cros_policy>;
		};
		usbc_port2: port2@2 {
			compatible = "named-usbc-port";
			reg = <2>;
			pdc = <&pdc_power_p2>;
			pd-retimer;
			policy = <&cros_policy>;
		};
		ppm-driver {
			compatible = "ucsi-ppm";
			b-num-alt-modes = <2>;
		};
	};
};

&i2c1 {
	pdc_power_p0: tps6699-pdc@24 {
		compatible = "ti,tps6699-pdc";
		reg = <0x24>;
		irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
		port-index-on-chip = <0x2>;
		no-fw-update;
		ccd;
		frs-supported;
	};
	pdc_power_p1: tps6699-pdc@20 {
		compatible = "ti,tps6699-pdc";
		reg = <0x20>;
		irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
		port-index-on-chip = <0x1>;
		frs-supported;
	};
	pdc_power_p2: tps6699-pdc@21 {
		compatible = "ti,tps6699-pdc";
		reg = <0x21>;
		irq-gpios = <&gpiob 2 GPIO_ACTIVE_LOW>;
		port-index-on-chip = <0x1>;
		frs-supported;
	};
};

&i2c4 {
	charger: isl9238@9 {
		compatible = "intersil,isl923x";
		status = "okay";
		reg = <0x9>;
	};
};
