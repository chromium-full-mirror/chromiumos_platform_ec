/ {
	named-i2c-ports {
		compatible = "named-i2c-ports";

		i2c_ec_i2c_eusba: ec_i2c_eusba {
			i2c-port = <&i2c0>;
			enum-names = "I2C_PORT_EUSBA";
		};
		i2c_ec_i2c_eusbb: ec_i2c_eusbb {
			i2c-port = <&i2c3>;
			enum-names = "I2C_PORT_EUSBB";
		};
		i2c_ec_i2c_pd_prog: ec_i2c_pd_prog {
			i2c-port = <&i2c1>;
			enum-names = "I2C_PORT_PD";
		};
		i2c_ec_i2c_charger: ec_i2c_charger {
			i2c-port = <&i2c4>;
			enum-names = "I2C_PORT_BATTERY";
		};
		i2c_ec_i2c_sensor: ec_i2c_sensor {
			i2c-port = <&i2c5>;
			enum-names = "I2C_PORT_SENSOR";
		};
	};
};

&i2c0 {
	pinctrl-0 = <&i2c0_clk_gpb3_default
		     &i2c0_data_gpb4_default>;
	pinctrl-names = "default";

	label = "I2C_PORT_EUSBA";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c1 {
	pinctrl-0 = <&i2c1_clk_gpc1_default
		     &i2c1_data_gpc2_default>;
	pinctrl-names = "default";

	label = "I2C_PORT_PD";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c3 {
	pinctrl-0 = <&i2c3_clk_gph1_default
		     &i2c3_data_gph2_default>;
	pinctrl-names = "default";

	label = "I2C_PORT_EUSBB";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c4 {
	pinctrl-0 = <&i2c4_clk_gpe0_default
		     &i2c4_data_gpe7_default>;
	pinctrl-names = "default";

	label = "I2C_PORT_CHARGER";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c5 {
	pinctrl-0 = <&i2c5_clk_gpe1_default
		     &i2c5_data_gpe2_default>;
	pinctrl-names = "default";
	target-enable;

	scl-gpios = <&gpioe 1 0>;
	sda-gpios = <&gpioe 2 0>;

	label = "I2C_PORT_SENSOR";
	clock-frequency = <I2C_BITRATE_FAST>;
	dsp_service: dsp-service@20 {
		compatible = "cros,dsp-service";
		reg = <0x20>;
		int-gpios = <&gpioh 6 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_LOW)>;
	};
};

&i2c0 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&i2c3 {
	status = "okay";
};

&i2c4 {
	status = "okay";
};

&i2c5 {
	status = "okay";
};
