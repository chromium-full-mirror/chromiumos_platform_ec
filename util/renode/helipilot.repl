using "platforms/cpus/nuvoton_npcx9.repl"

itim32_1:
    apb2Frequency: 16000000

itim32_2:
    apb2Frequency: 16000000

itim32_3:
    apb2Frequency: 16000000

itim32_4:
    apb2Frequency: 16000000

itim32_5:
    apb2Frequency: 16000000

itim32_6:
    apb2Frequency: 16000000

GPIO_WP: Miscellaneous.Button @ gpioa 4
    invert: true
    -> gpioa@4
    init:
        ReleaseOnReset false

GPIO_TRANSPORT_SEL: Miscellaneous.Button @ gpio4 3
    invert: true
    -> gpio4@3
    init:
        ReleaseOnReset false

fpsensor: Sensors.GenericSPISensor @ spip

// On NPCX9, battery-backed RAM occupies 0x400AF000..0x400AF07F (128 / 0x80
// bytes) and 0x400AF100 is the Write-1-To-Clear BKUP_STS control/status
// register. Upstream nuvoton_npcx9.repl maps battery_backed_ram at 0x400AF000
// with size 0x400, overlapping BKUP_STS at 0x400AF100 with ordinary RAM. When
// bbram_npcx_check_invalid() writes 0x80 (IBBR) to 0x400AF100 to clear the
// status bit, RAM retains 0x80 and causes subsequent boots across resets to
// treat BBRAM as corrupted. Unregister battery_backed_ram and replace it with
// a 0x80-byte memory so 0x400AF100 is not backed by RAM.
// TODO(b/567997307): Remove once battery_backed_ram size is fixed in upstream nuvoton_npcx9.repl.
battery_backed_ram: @ none
bbram: Memory.ArrayMemory @ sysbus 0x400AF000
    size: 0x80
